# Feedback provider: template (offline, default) | ollama | openai
FEEDBACK_PROVIDER=template

# Ollama (local LLM), used when FEEDBACK_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Any OpenAI-compatible /chat/completions API, used when FEEDBACK_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
